{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orionautomation",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "orionautomation.my/*", "zone_name": "orionautomation.my" },
    { "pattern": "www.orionautomation.my/*", "zone_name": "orionautomation.my" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
