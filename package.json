{
  "name": "orion-automation-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --test tests/brand-removal.test.js && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test:cloudflare": "node --test cloudflare/*.test.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@google/generative-ai": "^0.24.1",
    "animejs": "^3.2.1",
    "framer-motion": "^11.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.1",
    "wrangler": "4.155.0"
  }
}
